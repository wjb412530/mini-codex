# .env 配置文件示例
# 请将此文件复制为 .env 并填入你自己的配置。
# 通过 pipx 全局启动时，建议把 base_url/model 等非敏感项放入 ~/.mini-codex/config.json，
# 密钥则保持留在系统环境变量里。

# 默认使用的模型提供商 (openai 或 anthropic)
PROVIDER=openai

# --- OpenAI 或兼容接口配置 ---
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 可选，通义千问 Qwen / DeepSeek 等
MODEL_NAME=qwen-plus

# 是否展示思维链（思考过程）。设为 false 可关闭思考过程、输出更干净
SHOW_THINKING=true

# --- Anthropic 官方接口配置（可选依赖） ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxx
# MODEL_NAME=claude-sonnet-4-20250514

# --- 可选：MCP 服务器（JSON 数组，自动注册为工具） ---
# MINI_CODEX_MCP_SERVERS=[{"name":"fetch","description":"发起网络请求","command":"python -m my_mcp_server","input_schema":{"type":"object","properties":{"url":{"type":"string"}},"required":["url"]}}]